# 先将域名 A/AAAA 记录指向服务器，再填写域名（不要带 https://）。
JOBDECK_DOMAIN=jobdeck.example.com

# 公网部署默认启用多用户：每个 Sub2API 账号拥有独立工作区和插件连接码。
JOBDECK_MULTI_USER=true

# 邮箱注册/登录直连 Sub2API；不需要 OAuth。
SUB2API_BASE_URL=https://sub2api.aibro.vip

# 仅保存在服务端。用于给已验证 Star 的账号一次性发放额度。
SUB2API_ADMIN_API_KEY=
GITHUB_REPOSITORY=userInner/JobDeck
STAR_REWARD_USD=5

# 可选：提高 GitHub 公共 API 的请求额度，不需要用户提供 GitHub Token。
GITHUB_TOKEN=
